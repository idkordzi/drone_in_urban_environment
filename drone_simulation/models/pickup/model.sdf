    <plugin filename="ackerman-controller" name="AckermanController">
      <!-- <left_joint>FrontLeftWheelJoint</left_joint> -->
      <left_joint>RearLeftWheelJoint</left_joint>
      <!-- <right_joint>FrontRightWheelJoint</right_joint> -->
      <right_joint>RearRightWheelJoint</right_joint>
      <left_steering_joint>servo_c</left_steering_joint>
      <right_steering_joint>servo_c</right_steering_joint>
      <wheel_separation>1.9</wheel_separation>
      <!-- <kingpin_width>1.85</kingpin_width> -->
      <kingpin_width>0.0</kingpin_width>
      <wheel_base>3.56</wheel_base>
      <steering_limit>0.785</steering_limit>
      <wheel_radius>0.4</wheel_radius>
      <min_velocity>-0.5</min_velocity>
      <max_velocity>0.5</max_velocity>
      <min_acceleration>-6</min_acceleration>
      <max_acceleration>4</max_acceleration>
      <steer_p_gain>100.0</steer_p_gain>
    </plugin>

    <plugin filename="drive-to-pose-controller" name="DriveToPoseController">
      <linear_p_gain>1.0</linear_p_gain>
      <angular_p_gain>10.0</angular_p_gain>
    </plugin>

