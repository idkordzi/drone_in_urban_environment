            </metal>
          </pbr>
        </material>
      </visual> -->
      <collision name="FrontCenterWheelCollision">
        <pose relative_to="FrontCenterWheelJoint">0 0.0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.3</length>
            <radius>0.4</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>


