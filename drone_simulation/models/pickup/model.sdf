<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="pickup">
    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2300.0</mass>
        <inertia>
          <ixx>54.0</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>252.0</iyy>
          <iyz>0</iyz>
          <izz>252.0</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 0 0 -1.57079632679</pose>
        <geometry>
          <mesh>
            <uri>model://pickup/meshes/pickup_no_wheels.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0 0 0 -1.57079632679</pose>
        <geometry>
          <mesh>
            <uri>model://pickup/meshes/pickup_no_wheels.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>


    <joint name="servo_c" type="revolute">
      <parent>base_link</parent>
      <child>FrontCenterWheelSteering</child>
      <pose relative_to="base_link">1.78 0 0.4 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.57079</lower>
          <upper>1.57079</upper>
          <velocity>10.0</velocity>
          <effort>500.0</effort>
        </limit>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
    <link name="FrontCenterWheelSteering">
      <pose relative_to="servo_c">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>0.0000018</ixx>
          <iyy>0.0000018</iyy>
          <izz>0.0000018</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="FrontCenterWheelJoint" type="revolute">
      <parent>FrontCenterWheelSteering</parent>
      <child>FrontCenterWheel</child>
      <pose relative_to="servo_c" degrees="true">0 0 0 -90 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <velocity>50.0</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
    <link name="FrontCenterWheel">
      <pose relative_to="FrontCenterWheelJoint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>.05</mass>
        <inertia>
          <ixx>0.00003331</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000204</iyy>
          <iyz>0</iyz>
          <izz>0.0000204</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay/>
      <!-- <visual name="FrontCenterWheelVisual">
        <pose relative_to="FrontCenterWheelJoint">0 0.0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.3</length>
