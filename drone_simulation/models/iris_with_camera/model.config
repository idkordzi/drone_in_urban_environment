<?xml version="1.0"?>

<model>
  <name>Iris with Camera</name>
  <version>2.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Igor Kordzi</name>
    <email>igor.kordzi@gmail.com</email>
